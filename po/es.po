#: prefs.js:305
msgid "Check Command Exit Code"
msgstr "Comprobar el código de salida"

#: prefs.js:306
msgid "Only toggle if the command executes successfully (returns exit code 0)"
msgstr ""
"Solo cambia de estado si el comando se ejecuta correctamente (devuelve el "
"código de salida 0)"

#: prefs.js:327
