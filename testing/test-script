#!/bin/bash

start() {
    touch /tmp/custom-command-toggle-test
}

stop() {
    rm -f /tmp/custom-command-toggle-test
}

status() {
    sleep 1
    if [ -f /tmp/custom-command-toggle-test ]; then
        echo "[Custom Command Toggle] test script is ENABLED"
        exit 0
    else
        echo "[Custom Command Toggle] test script is DISABLED"
        exit 1
    fi
}


"$@"